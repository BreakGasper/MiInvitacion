        ".validate": "newData.hasChildren(['asistencia', 'confirmados', 'fecha'])",
        "asistencia": {
          ".validate": "newData.val() == 'si' || newData.val() == 'no'"
        },
        "confirmados": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= root.child('invitados').child($id).child('personas').val() && (newData.parent().child('asistencia').val() == 'no' || newData.val() >= 1)"
        },
        "asistentes": {
          ".validate": "newData.isString() && newData.val().length <= 1000"
        },
        "comentario": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "fecha": {
